# Yomi backend: local development settings.
# Copy to apps/api/.env and fill in. Every field and its default is in
# src/yomi/conf.py. Unset services fail with a clear error when first used.

# ── Core ─────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
APP_URL=http://localhost:3000
BACKEND_URL=http://localhost:8080
WEB_ORIGIN=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# ── Storage (Cloudflare D1 + Vectorize + R2 via the storage gateway) ────────
# Point at the staging gateway (wrangler.storage.toml) for local work.
STORAGE_BACKEND=d1
STORAGE_GATEWAY_URL=
STORAGE_GATEWAY_SECRET=

# ── Cloudflare (Workers AI, Browser Run) ────────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Model overrides (defaults in src/yomi/conf.py):
# WORKERS_AI_FAST_MODEL=@cf/zai-org/glm-5.3-flash
# WORKERS_AI_AGENT_MODEL=@cf/zai-org/glm-5.3-flash
# WORKERS_AI_SEARCH_MODEL=@cf/zai-org/glm-5.3-flash
# WORKERS_AI_EMBEDDING_MODEL=@cf/baai/bge-base-en-v1.5
# WORKERS_AI_STT_MODEL=@cf/openai/whisper-large-v3-turbo

# ── Auth ─────────────────────────────────────────────────────────────────────
BETTER_AUTH_SECRET=change-me
# Shared secret for /internal/* (cron dispatch, inbound email).
INTERNAL_API_KEY=change-me
# Google and GitHub sign-in (optional; Telegram sign-in needs only the bot).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Encryption ───────────────────────────────────────────────────────────────
# AES-256-GCM key, 64 hex characters: `openssl rand -hex 32`.
# FALLBACKS is a comma-separated list of old keys, used only to decrypt.
ENCRYPTION_KEY=
ENCRYPTION_KEY_FALLBACKS=

# ── Telegram ─────────────────────────────────────────────────────────────────
# Use a separate test bot for development.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_DEEP_LINK_ENABLED=true

# ── Connectors ───────────────────────────────────────────────────────────────
GOOGLE_INTEGRATIONS_CLIENT_ID=
GOOGLE_INTEGRATIONS_CLIENT_SECRET=
COMPOSIO_API_KEY=
COMPOSIO_CONNECTORS=
COMPOSIO_WEBHOOK_SECRET=
COMPOSIO_WEBHOOK_URL=
# Per-toolkit auth configs, e.g. COMPOSIO_GITHUB_AUTH_CONFIG_ID=ac_...

# ── Computer use (optional; apps/sandbox) ────────────────────────────────────
COMPUTER_GATEWAY_URL=
COMPUTER_GATEWAY_SECRET=

# ── Agent loop ───────────────────────────────────────────────────────────────
AGENT_MAX_STEPS=25
AGENT_MAX_OUTPUT_TOKENS=16384

# ── Payments (Dodo) ──────────────────────────────────────────────────────────
DODO_ENV=test
DODO_TEST_API_KEY=
DODO_TEST_WEBHOOK_SECRET=
DODO_TEST_PRODUCT_PRO=
DODO_TEST_PRODUCT_MAX=
DODO_TEST_PRODUCT_CREDITS_85=
DODO_TEST_PRODUCT_CREDITS_250=
DODO_TEST_PRODUCT_CREDITS_750=

# ── Observability and email (optional; each is off until set) ───────────────
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
RESEND_API_KEY=
EMAIL_FROM=Yomi <hello@getyomi.in>
EMAIL_REPLY_TO=

# ── Legacy Postgres (only with STORAGE_BACKEND=postgres) ────────────────────
# DATABASE_URL=postgresql://user:password@host:5432/yomi
