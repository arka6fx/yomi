# Yomi Python backend — copy to server/.env and fill in. All values optional;
# services fail explicitly at call time when a required secret is missing.
# See src/yomi/conf.py for every field and its default.

# core
ENVIRONMENT=development
DATABASE_URL=postgresql://user:password@host:5432/yomi
# Staged D1 + Vectorize gateway (keep DATABASE_URL during the migration).
STORAGE_GATEWAY_URL=
STORAGE_GATEWAY_SECRET=
# Personal computer gateway (sandbox worker per user workspace).
COMPUTER_GATEWAY_URL=
COMPUTER_GATEWAY_SECRET=
APP_URL=https://getyomi.in
BACKEND_URL=https://api.getyomi.in
WEB_ORIGIN=https://getyomi.in
CORS_ORIGIN=https://getyomi.in

# auth
BETTER_AUTH_SECRET=your-better-auth-secret
INTERNAL_API_KEY=your-internal-shared-secret

# llm: Cloudflare Workers AI for chat, embeddings, and STT (billed to the
# Cloudflare account). No OpenAI dependency remains.
# Optional overrides (defaults in src/yomi/conf.py):
# WORKERS_AI_FAST_MODEL=@cf/zai-org/glm-5.3-flash
# WORKERS_AI_AGENT_MODEL=@cf/zai-org/glm-5.3-flash
# WORKERS_AI_SEARCH_MODEL=@cf/zai-org/glm-5.3-flash
# WORKERS_AI_EMBEDDING_MODEL=@cf/baai/bge-base-en-v1.5
# WORKERS_AI_STT_MODEL=@cf/openai/whisper-large-v3-turbo

# telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_DEEP_LINK_ENABLED=true

# encryption (AES-256-GCM; 64-char hex). FALLBACKS comma-separated, decrypt-only.
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
ENCRYPTION_KEY_FALLBACKS=

# google integrations OAuth
GOOGLE_INTEGRATIONS_CLIENT_ID=
GOOGLE_INTEGRATIONS_CLIENT_SECRET=

# composio
COMPOSIO_API_KEY=
COMPOSIO_CONNECTORS=

# agent loop
AGENT_MAX_STEPS=25
AGENT_MAX_OUTPUT_TOKENS=16384

# dodo payments
DODO_ENV=test
DODO_API_KEY=
