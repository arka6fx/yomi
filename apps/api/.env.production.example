# Yomi backend: production Worker secrets.
#
# Production reads these as Worker Secrets on `yomi-backend`, not from a file.
# Keep real values in a gitignored apps/api/.env.production and set each one
# with `npx wrangler secret put <NAME>` from apps/api. See docs/runbook.md.
#
# Values that already exist in production must be copied, not regenerated.
# ENCRYPTION_KEY above all: a different key makes every stored token and vault
# item unreadable. To rotate, move the old key into ENCRYPTION_KEY_FALLBACKS.
#
# ENVIRONMENT, APP_URL, BACKEND_URL, WEB_ORIGIN, CORS_ORIGIN and
# CLOUDFLARE_ACCOUNT_ID are plain vars in wrangler.toml, not secrets.

# ── Storage ──────────────────────────────────────────────────────────────────
STORAGE_BACKEND=d1
STORAGE_GATEWAY_URL=<yomi-storage Worker URL>
STORAGE_GATEWAY_SECRET=<≥32 chars; same value on yomi-storage>

# ── Cloudflare ───────────────────────────────────────────────────────────────
CLOUDFLARE_API_TOKEN=<token with Workers AI and Browser Run access>

# ── Auth ─────────────────────────────────────────────────────────────────────
BETTER_AUTH_SECRET=<copy from production>
INTERNAL_API_KEY=<copy from production>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Encryption ───────────────────────────────────────────────────────────────
ENCRYPTION_KEY=<copy from production>
ENCRYPTION_KEY_FALLBACKS=

# ── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=yomi_assistant_bot
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_DEEP_LINK_ENABLED=true

# ── Connectors ───────────────────────────────────────────────────────────────
GOOGLE_INTEGRATIONS_CLIENT_ID=
GOOGLE_INTEGRATIONS_CLIENT_SECRET=
COMPOSIO_API_KEY=
COMPOSIO_CONNECTORS=
COMPOSIO_WEBHOOK_SECRET=
COMPOSIO_WEBHOOK_URL=https://api.getyomi.in/api/webhooks/composio
# COMPOSIO_<TOOLKIT>_AUTH_CONFIG_ID=ac_...  (one per toolkit; list in worker.ts)

# ── Computer use ─────────────────────────────────────────────────────────────
COMPUTER_GATEWAY_URL=<yomi-computer Worker URL>
COMPUTER_GATEWAY_SECRET=<same value on yomi-computer>

# ── Payments (Dodo, live) ────────────────────────────────────────────────────
DODO_ENV=live
DODO_LIVE_API_KEY=
DODO_LIVE_WEBHOOK_SECRET=
DODO_LIVE_API_BASE=https://live.dodopayments.com
DODO_LIVE_PRODUCT_PRO=pdt_0NgwvBztQlONUhcjj8dRV
DODO_LIVE_PRODUCT_MAX=pdt_0NgwwRz2Zr1tT7Gt6sTX7
DODO_LIVE_PRODUCT_CREDITS_85=pdt_0Ngwx0wIsANyg0EPsuGZF
DODO_LIVE_PRODUCT_CREDITS_250=pdt_0NgwxMAN1kq8yPm9j2TZr
DODO_LIVE_PRODUCT_CREDITS_750=pdt_0NgwxnLzq8R3xpm29Qcm7

# ── Observability and email (optional) ───────────────────────────────────────
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
RESEND_API_KEY=
EMAIL_FROM=Yomi <hello@getyomi.in>
EMAIL_REPLY_TO=
