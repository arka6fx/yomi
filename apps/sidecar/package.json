{
  "name": "@yomi/sidecar",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --env-file ../../.env --watch src/index.ts",
    "build:win32-x64": "bun build src/index.ts --compile --target bun-windows-x64   --outfile dist/sidecar-win32-x64.exe",
    "build": "bun run build:win32-x64",
    "build:ci": "bun build src/index.ts --outdir dist --target bun",
    "test": "bun test --pass-with-no-tests --isolate",
    "lint": "eslint src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/provider": "^1.1.3",
    "@langchain/core": "^1.1.48",
    "@langchain/langgraph": "^1.3.5",
    "@playwright/mcp": "^0.0.75",
    "@yomi/shared": "workspace:*",
    "ai": "^4.0.0",
    "cron-parser": "^5.5.0",
    "hono": "^4.5.0"
  },
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "@yomi/eslint-config": "workspace:*",
    "@yomi/typescript-config": "workspace:*",
    "typescript": "^5.5.0"
  }
}
