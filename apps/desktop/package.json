{
  "name": "@yomi/desktop",
  "version": "0.0.1",
  "description": "Yomi desktop companion shell",
  "author": "Yomi",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "cross-env ELECTRON_OZONE_PLATFORM_HINT=auto YOMI_DEV=true electron-vite dev",
    "build": "electron-vite build && electron-builder --config electron-builder.yml",
    "build:app": "electron-vite build",
    "build:ci": "electron-vite build",
    "build:deps": "bun --filter @yomi/sidecar build",
    "pack": "bun run build:deps && electron-vite build && electron-builder --config electron-builder.yml --dir",
    "dist:win": "bun run build:deps && electron-vite build && electron-builder --config electron-builder.yml --win",
    "preview": "electron-vite preview",
    "test": "bun test --pass-with-no-tests",
    "lint": "eslint src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/caveat": "^5.2.8",
    "@yomi/shared": "workspace:*",
    "@yomi/ui-connectors": "workspace:*",
    "electron-updater": "^6.8.9",
    "framer-motion": "^11.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@yomi/eslint-config": "workspace:*",
    "@yomi/typescript-config": "workspace:*",
    "cross-env": "^10.1.0",
    "electron": "^31.0.0",
    "electron-builder": "^25.0.0",
    "electron-vite": "^2.0.0",
    "typescript": "^5.5.0",
    "vite": "^5.0.0"
  }
}
