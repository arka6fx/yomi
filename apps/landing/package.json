{
  "name": "@yomi/landing",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "build:cloudflare": "npm run build && npm run prepare:cloudflare-assets",
    "build:ci": "next build",
    "start": "next start",
    "clean": "rm -rf .next .worker-assets",
    "prepare:cloudflare-assets": "node scripts/prepare-cloudflare-assets.mjs",
    "preview:cloudflare": "wrangler dev --env production",
    "deploy:staging": "npm run build && npm run prepare:cloudflare-assets && wrangler deploy --env staging",
    "deploy:production": "npm run build && npm run prepare:cloudflare-assets && wrangler deploy --env production && npm run smoke",
    "smoke": "node scripts/smoke.mjs",
    "lint": "eslint src",
    "format": "prettier --write --ignore-path ../../.prettierignore .",
    "format:check": "prettier --check --ignore-path ../../.prettierignore .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --passWithNoTests --coverage"
  },
  "dependencies": {
"@yomi/shared": "0.0.0",
    "@yomi/ui-connectors": "0.0.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.16.0",
    "next": "^16.2.6",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^2.1.8",
    "@yomi/eslint-config": "0.0.0",
    "@yomi/typescript-config": "0.0.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.5.0",
    "wrangler": "^4.0.0"
  },
  "browserslist": [
    "chrome >= 91",
    "edge >= 91",
    "firefox >= 90",
    "safari >= 15"
  ]
}



