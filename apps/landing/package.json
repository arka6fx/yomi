{
  "name": "@yomi/landing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "build:cloudflare": "bun run build && bun run prepare:cloudflare-assets",
    "build:ci": "next build",
    "start": "next start",
    "prepare:cloudflare-assets": "bun scripts/prepare-cloudflare-assets.mjs",
    "preview:cloudflare": "wrangler dev --env production",
    "deploy:staging": "bun run build && bun run prepare:cloudflare-assets && wrangler deploy --env staging",
    "deploy:production": "bun run build && bun run prepare:cloudflare-assets && wrangler deploy --env production && bun run smoke",
    "smoke": "bun scripts/smoke.mjs",
    "lint": "eslint src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "bun test --pass-with-no-tests"
  },
  "dependencies": {
    "@yomi/shared": "workspace:*",
    "@yomi/ui-connectors": "workspace:*",
    "better-auth": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.16.0",
    "next": "^16.2.6",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@yomi/eslint-config": "workspace:*",
    "@yomi/typescript-config": "workspace:*",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.5.0",
    "wrangler": "^4.0.0"
  },
  "browserslist": [
    "chrome >= 91",
    "edge >= 91",
    "firefox >= 90",
    "safari >= 15"
  ]
}
