{
  "name": "yomi-landing",
  "compatibility_date": "2026-06-11",
  "pages_build_output_dir": ".vercel/output/static",
  "vars": {
    "ENVIRONMENT": "development"
  },
  "env": {
    "staging": {
      "vars": {
        "ENVIRONMENT": "staging"
      }
    },
    "production": {
      "vars": {
        "ENVIRONMENT": "production"
      }
    }
  }
}
