{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "yomi-landing",
  "main": "src/worker.ts",
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat_v2"],
  "assets": {
    "directory": "./.worker-assets",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": true,
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "vars": {
    "ENVIRONMENT": "development",
  },
  "env": {
    "staging": {
      "name": "yomi-landing-staging",
      "vars": {
        "ENVIRONMENT": "staging",
      },
    },
    "production": {
      "name": "yomi-landing",
      "routes": [
        { "pattern": "getyomi.in", "custom_domain": true },
        { "pattern": "www.getyomi.in", "custom_domain": true },
      ],
      "vars": {
        "ENVIRONMENT": "production",
      },
    },
  },
}
