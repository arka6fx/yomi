{
  "name": "@yomi/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --env-file ../../.env --watch src/index.ts",
    "dev:cloudflare": "wrangler dev --local --port 8787",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "build:ci": "bun build src/index.ts --outdir dist --target bun",
    "start": "bun run dist/index.js",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production",
    "cf:check": "wrangler deploy --dry-run --env production",
    "test": "bun test --pass-with-no-tests --isolate",
    "lint": "eslint src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.9.0",
    "@yomi/agent-core": "workspace:*",
    "@yomi/db": "workspace:*",
    "@yomi/shared": "workspace:*",
    "ai": "^4.0.0",
    "better-auth": "^1.0.0",
    "drizzle-orm": "^0.31.0",
    "hono": "^4.5.0"
  },
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "@yomi/eslint-config": "workspace:*",
    "@yomi/typescript-config": "workspace:*",
    "drizzle-kit": "^0.22.0",
    "wrangler": "^4.0.0",
    "typescript": "^5.5.0"
  }
}
