{
  "name": "@yomi/backend",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "bun run --env-file ../../.env --watch src/index.ts",
    "dev:cloudflare": "wrangler dev --local --port 8787",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "build:ci": "bun build src/index.ts --outdir dist --target bun",
    "start": "bun run dist/index.js",
    "clean": "rm -rf dist",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production",
    "cf:check": "wrangler deploy --dry-run --env production",
    "test": "bun test --pass-with-no-tests --isolate",
    "test:coverage": "bun test --pass-with-no-tests --isolate --coverage --coverage-reporter=lcov --coverage-dir=coverage",
    "lint": "eslint src",
    "format": "prettier --write --ignore-path ../../.prettierignore .",
    "format:check": "prettier --check --ignore-path ../../.prettierignore .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@yomi/agent-core": "workspace:*",
    "@yomi/db": "workspace:*",
    "@yomi/shared": "workspace:*",
    "ai": "^4.0.0",
    "better-auth": "1.6.11",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "@yomi/eslint-config": "workspace:*",
    "@yomi/typescript-config": "workspace:*",
    "drizzle-kit": "^0.31.10",
    "wrangler": "^4.0.0",
    "typescript": "^7.0.2"
  }
}
