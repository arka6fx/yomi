{
  "name": "@yomi/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --env-file ../../.env --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "start": "bun run dist/index.js",
    "cf:deploy": "wrangler deploy",
    "cf:deploy:preview": "wrangler deploy --env preview",
    "cf:dev": "wrangler dev",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/openai": "^1.0.0",
    "@neondatabase/serverless": "^0.9.0",
    "@yomi/db": "workspace:*",
    "@yomi/shared": "workspace:*",
    "ai": "^4.0.0",
    "better-auth": "^1.0.0",
    "drizzle-orm": "^0.31.0",
    "hono": "^4.5.0",
    "openai": "^4.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "@yomi/eslint-config": "workspace:*",
    "@yomi/typescript-config": "workspace:*",
    "drizzle-kit": "^0.22.0",
    "typescript": "^5.5.0"
  }
}
