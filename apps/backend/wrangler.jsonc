{
  "name": "yomi-backend",
  "main": "src/index.ts",
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat_v2"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "ENVIRONMENT": "development",
    "DODO_ENV": "test",
    "BETTER_AUTH_URL": "https://yomi.arka6fx.com",
    "BETTER_AUTH_BASE_URL": "https://api.yomi.arka6fx.com",
    "CORS_ORIGIN": "https://yomi.arka6fx.com",
    "AI_CREDITS_BASE_URL": "https://api.aicredits.in/v1",
    "AI_CREDITS_EMBEDDING_MODEL": "text-embedding-3-small"
  },
  "env": {
    "staging": {
      "name": "yomi-backend-staging",
      "vars": {
        "ENVIRONMENT": "staging",
        "DODO_ENV": "test",
        "BETTER_AUTH_URL": "https://yomi.arka6fx.com",
        "BETTER_AUTH_BASE_URL": "https://api.yomi.arka6fx.com",
        "CORS_ORIGIN": "https://yomi.arka6fx.com",
        "AI_CREDITS_BASE_URL": "https://api.aicredits.in/v1",
        "AI_CREDITS_EMBEDDING_MODEL": "text-embedding-3-small"
      }
    },
    "production": {
      "name": "yomi-backend",
      "vars": {
        "ENVIRONMENT": "production",
        "DODO_ENV": "live",
        "BETTER_AUTH_URL": "https://yomi.arka6fx.com",
        "BETTER_AUTH_BASE_URL": "https://api.yomi.arka6fx.com",
        "CORS_ORIGIN": "https://yomi.arka6fx.com",
        "AI_CREDITS_BASE_URL": "https://api.aicredits.in/v1",
        "AI_CREDITS_EMBEDDING_MODEL": "text-embedding-3-small"
      }
    }
  }
}
