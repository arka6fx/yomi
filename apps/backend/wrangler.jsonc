{
  "name": "yomi-backend",
  "main": "src/worker.ts",
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat_v2"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "triggers": {
    "crons": ["* * * * *"],
  },
  "vars": {
    "ENVIRONMENT": "development",
    "BETTER_AUTH_URL": "https://getyomi.in",
    "BETTER_AUTH_BASE_URL": "https://api.getyomi.in",
    "CORS_ORIGIN": "https://getyomi.in",
    "OPENAI_BASE_URL": "https://api.openai.com/v1",
    "OPENAI_EMBEDDING_MODEL": "text-embedding-3-small",
    "OPENAI_FAST_MODEL": "gpt-5.5-mini",
    "OPENAI_AGENT_MODEL": "gpt-5.5",
    "NEXT_PUBLIC_APP_URL": "https://getyomi.in",
  },
  "env": {
    "staging": {
      "name": "yomi-backend-staging",
      "triggers": {
        "crons": ["* * * * *"],
      },
      "vars": {
        "ENVIRONMENT": "staging",
        "DODO_ENV": "test",
        "DODO_TEST_API_BASE": "https://test.dodopayments.com",
        "DODO_TEST_PRODUCT_PRO": "pdt_0NgpaqgPFPP1ILAL1KB4a",
        "DODO_TEST_PRODUCT_MAX": "pdt_0Ngpe8uJgzzFshRGbgSaa",
        "DODO_TEST_PRODUCT_CREDITS_85": "pdt_0Ngpf9viougexvvbfowTl",
        "DODO_TEST_PRODUCT_CREDITS_250": "pdt_0NgpfYVmpPRjuVRJFYZf1",
        "DODO_TEST_PRODUCT_CREDITS_750": "pdt_0NgpfusjWfLsZcKwGn7sT",
        "BETTER_AUTH_URL": "https://getyomi.in",
        "BETTER_AUTH_BASE_URL": "https://api.getyomi.in",
        "CORS_ORIGIN": "https://getyomi.in",
        "OPENAI_BASE_URL": "https://api.openai.com/v1",
        "OPENAI_EMBEDDING_MODEL": "text-embedding-3-small",
        "OPENAI_FAST_MODEL": "gpt-5.5-mini",
        "OPENAI_AGENT_MODEL": "gpt-5.5",
        "NEXT_PUBLIC_APP_URL": "https://getyomi.in",
      },
    },
    "production": {
      "name": "yomi-backend",
      "triggers": {
        "crons": ["* * * * *"],
      },
      "vars": {
        "ENVIRONMENT": "production",
        "DODO_ENV": "live",
        "DODO_LIVE_API_BASE": "https://live.dodopayments.com",
        "DODO_LIVE_PRODUCT_PRO": "pdt_0NgwvBztQlONUhcjj8dRV",
        "DODO_LIVE_PRODUCT_MAX": "pdt_0NgwwRz2Zr1tT7Gt6sTX7",
        "DODO_LIVE_PRODUCT_CREDITS_85": "pdt_0Ngwx0wIsANyg0EPsuGZF",
        "DODO_LIVE_PRODUCT_CREDITS_250": "pdt_0NgwxMAN1kq8yPm9j2TZr",
        "DODO_LIVE_PRODUCT_CREDITS_750": "pdt_0NgwxnLzq8R3xpm29Qcm7",
        "BETTER_AUTH_URL": "https://getyomi.in",
        "BETTER_AUTH_BASE_URL": "https://api.getyomi.in",
        "CORS_ORIGIN": "https://getyomi.in",
        "OPENAI_BASE_URL": "https://api.openai.com/v1",
        "OPENAI_EMBEDDING_MODEL": "text-embedding-3-small",
        "OPENAI_FAST_MODEL": "gpt-5.5-mini",
        "OPENAI_AGENT_MODEL": "gpt-5.5",
        "NEXT_PUBLIC_APP_URL": "https://getyomi.in",
        "TELEGRAM_BOT_USERNAME": "yomi_assistant_bot",
        "TELEGRAM_DEEP_LINK_ENABLED": "true",
      },
    },
  },
}
