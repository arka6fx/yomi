<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>uia-helper</AssemblyName>
    <RootNamespace>Yomi.UiaHelper</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Single self-contained .exe so the user needs no .NET install. Publish with:
         dotnet publish -c Release -r win-x64 -p:PublishSingleFile=true (self-contained by default for RID) -->
    <RuntimeIdentifier Condition="'$(PublishSingleFile)' == 'true'">win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FlaUI.UIA3" Version="4.0.0" />
    <!-- Core Audio (WASAPI) — per-app volume in the Windows mixer, for focus-free Spotify ducking. -->
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>

</Project>
