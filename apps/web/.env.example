# Yomi web app: local development settings.
# Copy to apps/web/.env.local. NEXT_PUBLIC_* values are baked in at build time.

# FastAPI backend that /api/* is rewritten to (npm run python:dev).
BACKEND_URL=http://localhost:8080
NEXT_PUBLIC_API_URL=http://localhost:8080

# Product analytics (optional).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
