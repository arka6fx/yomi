{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "enabled": true,
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}",
      },
    },
    "razorpay": {
      "type": "local",
      "command": ["npx", "-y", "mcp-remote", "https://mcp.razorpay.com/mcp", "--header", "Authorization: ${RAZORPAY_MCP_AUTH}"],
      "enabled": true,
    },
  },
}
