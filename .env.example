# ── Database (Neon serverless Postgres) ──────────────────────────────────────
DATABASE_URL=

# ── Auth (Better Auth) ───────────────────────────────────────────────────────
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001

# Owner allowlist — these accounts get effective role="owner" and max access
OWNER_EMAIL=
OWNER_EMAILS=arkagarai292@gmail.com
OWNER_USER_IDS=

# Google OAuth — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth — https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# AES-256-GCM key for encrypting oauth_tokens at rest (32 random bytes as hex)
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=

# ── AI Credits LLM routing (OpenAI-compatible API) ───────────────────────────
# Use your AI Credits key here. The env var is named OPENAI_API_KEY because
# the Vercel AI SDK OpenAI-compatible provider reads this name.
OPENAI_API_KEY=
# AI Credits OpenAI-compatible base URL.
OPENAI_BASE_URL=

# ── Sarvam AI — Speech-to-Text + Text-to-Speech ──────────────────────────────
SARVAM_API_KEY=

# ── Billing (Razorpay) ───────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Speech override ───────────────────────────────────────────────────────────
# Set TTS_ENGINE=none to disable voice responses
TTS_ENGINE=sarvam

# ── Desktop ↔ Sidecar auth token ─────────────────────────────────────────────
SIDECAR_SECRET=

# ── Landing page ─────────────────────────────────────────────────────────────
BACKEND_URL=http://localhost:3001
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Landing auth (uses same DB and OAuth credentials as backend above)

# ── Optional: override sidecar model routing ─────────────────────────────────
# FAST_PATH_MODEL=gpt-4.1-mini
# AGENT_PATH_MODEL=gpt-4.1

# ── Optional: cloud RAG hybrid retrieval (backend) ───────────────────────────
# EMBEDDING_MODEL=text-embedding-3-small
# RAG_CANDIDATES=30          # candidates pulled per arm before fusion
# RAG_RRF_K=60               # Reciprocal Rank Fusion constant
# RAG_MMR_LAMBDA=0.7         # MMR relevance vs novelty (1=pure relevance)
# RAG_RERANK_LLM=false       # set true to add an LLM listwise rerank pass
# RAG_RERANK_MODEL=gpt-4.1-mini
# RAG_RERANK_TIMEOUT_MS=800  # LLM rerank timeout; falls back to MMR order
