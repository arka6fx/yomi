# ── Database (Neon serverless Postgres) ──────────────────────────────────────
DATABASE_URL=

# ── Auth (Better Auth) ───────────────────────────────────────────────────────
BETTER_AUTH_SECRET=
# Public app origin. Backend uses this for trusted origins and CORS.
BETTER_AUTH_URL=http://localhost:3000
# Backend origin used by Better Auth.
BETTER_AUTH_BASE_URL=http://localhost:3001

# Owner allowlist — these accounts get effective role="owner" and max access
OWNER_EMAIL=
OWNER_EMAILS=
OWNER_USER_IDS=

# Google OAuth — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth — https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# AES-256-GCM key for encrypting oauth_tokens at rest (32 random bytes as hex)
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=

# ── AI Credits LLM routing (OpenAI-compatible API) ───────────────────────────
# Use your AI Credits key here. The env var is named OPENAI_API_KEY because
# the Vercel AI SDK OpenAI-compatible provider reads this name.
OPENAI_API_KEY=
# AI Credits OpenAI-compatible base URL.
OPENAI_BASE_URL=

# ── ElevenLabs — Speech-to-Text + Text-to-Speech ─────────────────────────────
ELEVENLABS_API_KEY=
# Use a premade voice ID — community "library" voices need a paid plan for API use.
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5

# ── Billing (Razorpay) ───────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Speech override ───────────────────────────────────────────────────────────
# Set TTS_ENGINE=none to disable voice responses
TTS_ENGINE=elevenlabs

# ── Desktop ↔ Sidecar auth token ─────────────────────────────────────────────
SIDECAR_SECRET=

# ── Landing page ─────────────────────────────────────────────────────────────
BACKEND_URL=http://localhost:3001
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production uses https://yomi.arka6fx.com for all three URL values above.

# ── Desktop ───────────────────────────────────────────────────────────────────
YOMI_BACKEND_URL=http://localhost:3001

# ── CORS (backend only) ─────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000
