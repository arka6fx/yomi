# ── Database (Neon serverless Postgres) ──────────────────────────────────────
DATABASE_URL=

# ── Auth (Better Auth) ───────────────────────────────────────────────────────
BETTER_AUTH_SECRET=
# Public app origin. Backend uses this for trusted origins and CORS.
BETTER_AUTH_URL=http://localhost:3000
# Backend origin used by Better Auth.
BETTER_AUTH_BASE_URL=http://localhost:3001

# Owner allowlist — these accounts get effective role="owner" and max access
OWNER_EMAIL=
OWNER_EMAILS=
OWNER_USER_IDS=

# Google OAuth — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth — https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Notion OAuth — https://www.notion.so/my-integrations (Public integration type)
# Redirect URI: BACKEND_URL + /api/integrations/callback/notion
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# Slack OAuth — https://api.slack.com/apps
# Bot scopes: channels:read, chat:write — User scope: search:read
# Redirect URI: BACKEND_URL + /api/integrations/callback/slack
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Linear OAuth — https://linear.app/settings/api (OAuth applications section)
# Scopes: read, write
# Redirect URI: BACKEND_URL + /api/integrations/callback/linear
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=

# Google Integrations OAuth — separate GCP app with Gmail/Drive/Calendar scopes
# Create a second OAuth 2.0 client (not the login one) with scope:
#   https://www.googleapis.com/auth/gmail.modify
#   https://www.googleapis.com/auth/drive
#   https://www.googleapis.com/auth/calendar
# Redirect URI: BACKEND_URL + /api/integrations/google/callback
GOOGLE_INTEGRATIONS_CLIENT_ID=
GOOGLE_INTEGRATIONS_CLIENT_SECRET=
GOOGLE_INTEGRATIONS_REDIRECT_URI=http://localhost:3001/api/integrations/google/callback

# AES-256-GCM key for encrypting oauth_tokens at rest (32 random bytes as hex)
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=

# Optional comma-separated 64-char hex keys also accepted when DECRYPTING tokens.
# Use during key rotation, or when multiple environments share one database with
# different ENCRYPTION_KEY values, so existing tokens decrypt without reconnect.
# New tokens are always encrypted with ENCRYPTION_KEY above.
ENCRYPTION_KEY_FALLBACKS=

# ── Composio (tool backend for connectors) ──────────────────────────────────────
# Get your API key at https://app.composio.dev
COMPOSIO_API_KEY=
# Comma-separated list of connector ids served by Composio (instead of native)
COMPOSIO_CONNECTORS=linear,github,slack,notion
# Auth config IDs from Composio dashboard → Auth Configs for each toolkit
COMPOSIO_LINEAR_AUTH_CONFIG_ID=
COMPOSIO_GITHUB_AUTH_CONFIG_ID=
COMPOSIO_SLACK_AUTH_CONFIG_ID=
COMPOSIO_NOTION_AUTH_CONFIG_ID=
# Google connector auth config IDs (fill if any are in COMPOSIO_CONNECTORS)
COMPOSIO_GMAIL_AUTH_CONFIG_ID=
COMPOSIO_CALENDAR_AUTH_CONFIG_ID=
COMPOSIO_DRIVE_AUTH_CONFIG_ID=
COMPOSIO_CLASSROOM_AUTH_CONFIG_ID=
COMPOSIO_TASKS_AUTH_CONFIG_ID=
COMPOSIO_CONTACTS_AUTH_CONFIG_ID=
COMPOSIO_MEET_AUTH_CONFIG_ID=

# ── AI Credits / OpenAI-compatible LLM routing ───────────────────────────────
# Required on the backend (for server-side gateway/Telegram answers).
# OPENAI_BASE_URL defaults to OpenAI if unset;
# set to https://api.openai.com/v1 for AI Credits.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_FAST_MODEL=gpt-5.4-mini
OPENAI_AGENT_MODEL=gpt-5.5
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── ElevenLabs STT/TTS ───────────────────────────────────────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5

# ── Agent docs (Context7 MCP) ────────────────────────────────────────────────

# ── Billing (Dodo Payments) ──────────────────────────────────────────────────
DODO_ENV=test

# Test mode
DODO_TEST_API_KEY=
DODO_TEST_WEBHOOK_SECRET=
# Defaults to https://test.dodopayments.com (test) / https://live.dodopayments.com (live)
DODO_TEST_API_BASE=
DODO_TEST_PRODUCT_PRO=
DODO_TEST_PRODUCT_MAX=
DODO_TEST_PRODUCT_CREDITS_500=
DODO_TEST_PRODUCT_CREDITS_2000=
DODO_TEST_PRODUCT_CREDITS_6000=

# Live mode
DODO_LIVE_API_KEY=
DODO_LIVE_WEBHOOK_SECRET=
# Defaults to https://live.dodopayments.com
DODO_LIVE_API_BASE=
DODO_LIVE_PRODUCT_PRO=
DODO_LIVE_PRODUCT_MAX=
DODO_LIVE_PRODUCT_CREDITS_500=
DODO_LIVE_PRODUCT_CREDITS_2000=
DODO_LIVE_PRODUCT_CREDITS_6000=

# ── Speech override ───────────────────────────────────────────────────────────
# Set TTS_ENGINE to "elevenlabs" or "none" to disable voice output.
TTS_ENGINE=elevenlabs

# ── Gateway ──────────────────────────────────────────────────────────────────
# Set to 1 to have the backend answer gateway (Telegram) messages
# server-side. Requires OPENAI_* to be set on the backend.
YOMI_GATEWAY_BACKEND=1

# ── Landing page ─────────────────────────────────────────────────────────────
BACKEND_URL=http://localhost:3001
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production split-domain values:
# BETTER_AUTH_URL=https://yomi.arka6fx.com
# BETTER_AUTH_BASE_URL=https://api.yomi.arka6fx.com
# BACKEND_URL=https://api.yomi.arka6fx.com
# Do NOT set this in production. Auth client must use same-origin (yomi.arka6fx.com)
# so OAuth cookies are set for the correct domain. The landing worker proxies to backend.
# NEXT_PUBLIC_BACKEND_URL=https://api.yomi.arka6fx.com
# NEXT_PUBLIC_APP_URL=https://yomi.arka6fx.com
# YOMI_BACKEND_URL=https://api.yomi.arka6fx.com
# CORS_ORIGIN=https://yomi.arka6fx.com

# ── App URLs ──────────────────────────────────────────────────────────────────
YOMI_BACKEND_URL=http://localhost:3001
YOMI_APP_URL=http://localhost:3000

# ── CORS (backend only) ───────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000
