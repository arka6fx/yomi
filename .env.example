# ── Database (Neon serverless Postgres) ──────────────────────────────────────
DATABASE_URL=

# ── Auth (Better Auth) ───────────────────────────────────────────────────────
BETTER_AUTH_SECRET=
# Public app origin. Backend uses this for trusted origins and CORS.
BETTER_AUTH_URL=http://localhost:3000
# Backend origin used by Better Auth.
BETTER_AUTH_BASE_URL=http://localhost:3001

# Owner allowlist — these accounts get effective role="owner" and max access
OWNER_EMAIL=
OWNER_EMAILS=
OWNER_USER_IDS=

# Google OAuth — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth — https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# AES-256-GCM key for encrypting oauth_tokens at rest (32 random bytes as hex)
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=

# ── AWS Bedrock — LLM (MiniMax M2.5) via OpenAI-compatible mantle endpoint ───
# Bedrock API key (ABSK...) for accessing models via the OpenAI-compatible mantle endpoint.
AWS_BEDROCK_BEARER_TOKEN=
# Bedrock mantle base URL. Change region if not us-east-1.
AWS_BEDROCK_BASE_URL=https://bedrock-mantle.us-east-1.api.aws/v1
AWS_BEDROCK_REGION=us-east-1

# ── AWS Bedrock — IAM credentials (for Converse API — Nova Sonic) ────────────
# Required for Nova Sonic speech-to-speech via the Converse API (SigV4 auth).
# On EC2, prefer an IAM role instead — the SDK auto-detects it.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Legacy: OpenAI / AI Credits LLM routing (kept for rollback) ──────────────
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# ── Legacy: ElevenLabs STT/TTS (kept for rollback) ──────────────────────────
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
# ELEVENLABS_STT_MODEL=scribe_v2
# ELEVENLABS_TTS_MODEL=eleven_flash_v2_5

# ── Billing (Dodo Payments) ──────────────────────────────────────────────────
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
# Defaults to https://api.dodopayments.com. Override for sandbox/test mode.
DODO_API_BASE=
# Product IDs from Dodo dashboard
DODO_PRODUCT_PRO=
DODO_PRODUCT_MAX=
DODO_PRODUCT_CREDITS_500=
DODO_PRODUCT_CREDITS_2000=
DODO_PRODUCT_CREDITS_6000=

# ── Speech override ───────────────────────────────────────────────────────────
# Set TTS_ENGINE to "nova-sonic" (Bedrock), "elevenlabs" (legacy), or "none" to disable
TTS_ENGINE=nova-sonic

# ── Desktop ↔ Sidecar auth + routing ─────────────────────────────────────────
SIDECAR_SECRET=
# Backend uses this to forward gateway messages to the user's sidecar.
SIDECAR_URL=http://localhost:3002

# ── Landing page ─────────────────────────────────────────────────────────────
BACKEND_URL=http://localhost:3001
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production uses https://yomi.arka6fx.com for all three URL values above.

# ── Messaging Gateway (Telegram / Discord) ──────────────────
# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Discord bot token from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=
# Discord OAuth2 credentials (for identify scope linking — DM onboarding)
# Get CLIENT_SECRET from https://discord.com/developers/applications/1513769981773480068/oauth2
DISCORD_CLIENT_ID=1513769981773480068
DISCORD_CLIENT_SECRET=
# Dev: http://localhost:3001/api/gateway/discord/callback
# Prod: https://yomi.arka6fx.com/api/gateway/discord/callback
DISCORD_REDIRECT_URI=

# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=yomi_assistant_bot
TELEGRAM_DEEP_LINK_ENABLED=false

# ── Landing ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_DISCORD_INVITE=https://discord.gg/your-invite-code

# ── Desktop ───────────────────────────────────────────────────────────────────
YOMI_BACKEND_URL=http://localhost:3001

# ── CORS (backend only) ─────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000
