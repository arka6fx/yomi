# ── Database (Neon serverless Postgres) ──────────────────────────────────────
DATABASE_URL=

# ── Auth (Better Auth) ───────────────────────────────────────────────────────
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001

# Google OAuth — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth — https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# AES-256-GCM key for encrypting oauth_tokens at rest (32 random bytes as hex)
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=

# ── LLM keys — cloud backend only, NEVER shipped to desktop/sidecar ──────────
ANTHROPIC_API_KEY=

# ── Billing (Stripe) ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_MAX_PRICE_ID=
STRIPE_TEAM_PRICE_ID=

# ── Speech (ElevenLabs) ───────────────────────────────────────────────────────
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM  # default: Rachel

# ── LLM routing (Vercel AI SDK) ───────────────────────────────────────────────
# Leave blank to use Anthropic directly.
# Set both to use OpenRouter (any model, no direct subscription needed):
OPENROUTER_API_KEY=
# LLM_BASE_URL=https://openrouter.ai/api/v1

# ── Desktop ↔ Sidecar auth token (generated at install time) ─────────────────
SIDECAR_SECRET=

# ── Landing page ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001

# ── GitHub MCP (for opencode / AI agent tooling) ──────────────────────────────
# Generate a PAT at https://github.com/settings/tokens — scopes: repo, issues, pull_requests
GITHUB_PERSONAL_ACCESS_TOKEN=

# ── Optional: override model routing ─────────────────────────────────────────
# FAST_PATH_MODEL=claude-haiku-4-5-20251001
# AGENT_PATH_MODEL=claude-sonnet-4-6
# Or any OpenRouter model ID, e.g. anthropic/claude-haiku-4-5 or mistralai/mistral-7b-instruct
