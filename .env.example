# ── Database (Neon serverless Postgres) ──────────────────────────────────────
DATABASE_URL=

# ── Auth (Better Auth) ───────────────────────────────────────────────────────
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001

# Owner email — this account gets role="owner" with unrestricted max access
OWNER_EMAIL=

# Google OAuth — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth — https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# AES-256-GCM key for encrypting oauth_tokens at rest (32 random bytes as hex)
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=

# ── OpenAI — LLM routing (chat, vision, reasoning) ───────────────────────────
OPENAI_API_KEY=
# Optional: custom base URL (e.g. for proxy or Azure OpenAI)
# OPENAI_BASE_URL=

# ── Sarvam AI — Speech-to-Text + Text-to-Speech ──────────────────────────────
SARVAM_API_KEY=

# ── Billing (Razorpay) ───────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Speech override ───────────────────────────────────────────────────────────
# Optional: set TTS_ENGINE=none to disable voice responses
# TTS_ENGINE=sarvam

# ── Desktop ↔ Sidecar auth token ─────────────────────────────────────────────
SIDECAR_SECRET=

# ── Landing page ─────────────────────────────────────────────────────────────
BACKEND_URL=http://localhost:3001
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Landing auth (uses same DB and OAuth credentials as backend above)

# ── Optional: override sidecar model routing ─────────────────────────────────
# FAST_PATH_MODEL=gpt-4.1-mini
# AGENT_PATH_MODEL=gpt-4.1
