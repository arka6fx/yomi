# ── Database (Neon serverless Postgres) ──────────────────────────────────────
DATABASE_URL=

# ── Auth (Better Auth) ───────────────────────────────────────────────────────
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001

# Google OAuth — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth — https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# AES-256-GCM key for encrypting oauth_tokens at rest (32 random bytes as hex)
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=

# ── OpenAI — all AI routing goes through OpenAI models ───────────────────────
OPENAI_API_KEY=
# Optional: custom base URL (e.g. for proxy or Azure OpenAI)
# OPENAI_BASE_URL=

# ── Billing (Razorpay) ───────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Speech (uses OPENAI_API_KEY above) ───────────────────────────────────────
# Optional: override model names
# STT_MODEL=whisper-1
# TTS_MODEL=gpt-4o-mini-tts
# TTS_ENGINE=openai

# ── Desktop ↔ Sidecar auth token ─────────────────────────────────────────────
SIDECAR_SECRET=

# ── Landing page ─────────────────────────────────────────────────────────────
BACKEND_URL=http://localhost:3001
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001

# ── GitHub PAT (for opencode / AI tooling) ───────────────────────────────────
# Scopes: repo, issues, pull_requests
# GITHUB_PERSONAL_ACCESS_TOKEN=

# ── Optional: override sidecar model routing ─────────────────────────────────
# FAST_PATH_MODEL=gpt-4.1-mini
# AGENT_PATH_MODEL=gpt-4.1
# IMAGE_MODEL=gpt-4.1-mini
