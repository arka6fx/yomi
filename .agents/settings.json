{
  "allowedTools": [
    "Bash(bun install*)",
    "Bash(bun run *)",
    "Bash(bunx *)",
    "Bash(turbo *)",
    "Bash(git status)",
    "Bash(git diff*)",
    "Bash(git log*)",
    "Bash(git add *)",
    "Bash(git commit*)",
    "Bash(git checkout *)",
    "Bash(git branch*)",
    "Bash(cd apps/backend && bun run db:*)",
    "Bash(cd packages/db && bun run db:*)",
    "Bash(find . *)",
    "Bash(grep *)",
    "Bash(rg *)",
    "Bash(wc -l *)",
    "Bash(ls *)"
  ],
  "ignorePatterns": [
    "node_modules",
    "dist",
    ".next",
    ".turbo",
    "bun.lockb"
  ],
  "hooks": {
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "mkdir -p ~/.yomi/sessions && echo \"$(date -Iseconds) session\" >> ~/.yomi/sessions/$(date +%Y-%m-%d)-dev.md"
          }
        ]
      }
    ]
  }
}
