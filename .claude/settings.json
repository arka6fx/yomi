{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash",
      "Edit",
      "Write",
      "WebFetch",
      "WebSearch",
      "Agent",
      "mcp__github",
      "mcp__playwright",
      "mcp__context7",
      "mcp__dodo-payments",
      "mcp__better-auth"
    ],
    "ask": [
      "Bash(npx wrangler deploy:*)",
      "Bash(wrangler deploy:*)",
      "Bash(npm run deploy:*)",
      "Bash(npx wrangler secret:*)",
      "Bash(wrangler secret:*)",
      "Bash(npx wrangler d1 migrations apply:*)",
      "Bash(wrangler d1 migrations apply:*)",
      "Bash(npx wrangler d1 execute:*)",
      "Bash(uv run alembic upgrade:*)"
    ],
    "deny": [
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.production)"
    ]
  },
  "enableAllProjectMcpServers": true,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
