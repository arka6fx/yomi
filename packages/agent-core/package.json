{
  "name": "@yomi/agent-core",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./connectors/google-gmail": "./src/connectors/google-gmail.ts"
  },
  "scripts": {
    "build:ci": "exit 0",
    "test": "bun test --pass-with-no-tests",
    "test:coverage": "bun test --pass-with-no-tests --coverage --coverage-reporter=lcov --coverage-dir=coverage",
    "lint": "eslint src",
    "format": "prettier --write --ignore-path ../../.prettierignore .",
    "format:check": "prettier --check --ignore-path ../../.prettierignore .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/provider": "^1.1.3",
    "@yomi/shared": "workspace:*",
    "ai": "^4.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "@yomi/eslint-config": "workspace:*",
    "@yomi/typescript-config": "workspace:*",
    "typescript": "^5.5.0"
  }
}
