{
  "name": "@yomi/shared",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./plans": "./src/plans.ts",
    "./privacy": "./src/privacy.ts",
    "./ai-pricing": "./src/ai-pricing.ts",
    "./starter-prompts": "./src/starter-prompts.ts"
  },
  "scripts": {
    "test": "bun test --pass-with-no-tests",
    "test:coverage": "bun test --pass-with-no-tests --coverage --coverage-reporter=lcov --coverage-dir=coverage",
    "lint": "eslint src",
    "format": "prettier --write --ignore-path ../../.prettierignore .",
    "format:check": "prettier --check --ignore-path ../../.prettierignore .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@yomi/eslint-config": "workspace:*",
    "@yomi/typescript-config": "workspace:*",
    "typescript": "^5.5.0"
  }
}
