# Yomi backend — production Worker secrets.
# Set with `wrangler secret put <NAME>` (see RUNBOOK.md). Never commit real
# values. `.env.production` is only the local copy you read values from.
#
# Values marked <FILL: copy from Cloudflare> must match the CURRENT production
# Worker secrets exactly. ENCRYPTION_KEY especially — a different key makes every
# stored connector token undecryptable (reconnect loop). If you must rotate it,
# put the OLD key in ENCRYPTION_KEY_FALLBACKS so existing tokens still decrypt.

# --- core ---
ENVIRONMENT=production
PORT=3001
DATABASE_URL=<FILL: Neon PostgreSQL connection string (pooler host, sslmode=require)>
ENCRYPTION_KEY=<FILL: copy from Cloudflare — MUST match prod>
ENCRYPTION_KEY_FALLBACKS=
BETTER_AUTH_SECRET=<FILL: copy from Cloudflare — MUST match prod>
OAUTH_STATE_SECRET=<FILL: copy from Cloudflare>

# --- public URLs (new domain) ---
BETTER_AUTH_URL=https://getyomi.in
BETTER_AUTH_BASE_URL=https://api.getyomi.in
CORS_ORIGIN=https://getyomi.in
NEXT_PUBLIC_APP_URL=https://getyomi.in
YOMI_APP_URL=https://getyomi.in

# --- OAuth (Better Auth sign-in) ---
GOOGLE_CLIENT_ID=<FILL>
GOOGLE_CLIENT_SECRET=<FILL>
GITHUB_CLIENT_ID=<FILL>
GITHUB_CLIENT_SECRET=<FILL>
# GitHub/Google/Slack/Notion/Linear connectors route exclusively through
# Composio now (see COMPOSIO_CONNECTORS / COMPOSIO_API_KEY in .env.example) —
# no separate native OAuth app needed for any of them.

# --- LLM (AI Credits, OpenAI-compatible) ---
OPENAI_API_KEY=<FILL>
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_FAST_MODEL=gpt-5.4-mini
OPENAI_AGENT_MODEL=gpt-5.5
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Telegram ---
TELEGRAM_BOT_TOKEN=<FILL>
TELEGRAM_BOT_USERNAME=yomi_assistant_bot
TELEGRAM_DEEP_LINK_ENABLED=true

# --- Billing (Dodo, live) ---
DODO_ENV=live
DODO_API_KEY=<FILL>
DODO_LIVE_API_BASE=https://live.dodopayments.com
DODO_LIVE_PRODUCT_PRO=pdt_0NgwvBztQlONUhcjj8dRV
DODO_LIVE_PRODUCT_MAX=pdt_0NgwwRz2Zr1tT7Gt6sTX7
DODO_LIVE_PRODUCT_CREDITS_85=pdt_0Ngwx0wIsANyg0EPsuGZF
DODO_LIVE_PRODUCT_CREDITS_250=pdt_0NgwxMAN1kq8yPm9j2TZr
DODO_LIVE_PRODUCT_CREDITS_750=pdt_0NgwxnLzq8R3xpm29Qcm7
