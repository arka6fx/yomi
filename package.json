{
  "name": "yomi",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "build:ci": "turbo run build:ci",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "docs:check": "bun scripts/check-docs-sync.ts",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "clean": "turbo run clean",
    "clean:all": "turbo run clean && find . -name 'node_modules' -type d -prune -exec rm -rf '{}' +"
  },
  "devDependencies": {
    "@yomi/eslint-config": "workspace:*",
    "@yomi/typescript-config": "workspace:*",
    "eslint": "^10.4.0",
    "prettier": "^3.0.0",
    "turbo": "^2.9.14",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20",
    "bun": ">=1.1.0"
  },
  "packageManager": "bun@1.3.14"
}
